APP_NAME=Tungelligence Agentic RAG
APP_VERSION=1.5.4
ENVIRONMENT=development
DEBUG=false

API_HOST=127.0.0.1
API_PORT=8000

# Local LLM. Qwen3:8b is a strong local default with a 40K context window in Ollama.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=180

EMBEDDING_PROVIDER=sentence_transformers
VECTOR_STORE_BACKEND=faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

TOP_K=8
RERANK_TOP_K=4
RETRIEVAL_MIN_SCORE=0.20
RERANK_MIN_SCORE=0.10

CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_DOCUMENT_SIZE_MB=25

CONVERSATION_HISTORY_MESSAGES=12
MAX_HISTORY_CHARS=12000
MAX_CONTEXT_CHARS=28000

# Offline development fallback only.
# EMBEDDING_PROVIDER=hash
# VECTOR_STORE_BACKEND=numpy
# EMBEDDING_DIMENSION=128
